        { "id": "ep_names", "label": "Environmental Professional Name(s)", "type": "Array<String>", "required": true, "validation": ["min_length:1"] },
        { "id": "ep_certification_date", "label": "EP Declaration Date", "type": "Date", "required": true, "validation": ["equals:report_date"] },
        { "id": "ep_qualifications_confirmed", "label": "EP Qualifications Confirmed", "type": "Boolean", "required": true, "validation": ["equals:true"] }
