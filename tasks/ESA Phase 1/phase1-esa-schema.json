        { "id": "edr_report", "label": "Environmental Database Report", "type": "Array<Photo>", "required": true },
        { "id": "historical_aerials", "label": "Historical Aerial Photographs", "type": "Array<Photo>", "required": false },
        { "id": "foia_responses", "label": "FOIA Documents", "type": "Array<Photo>", "required": false },
        { "id": "proposal_agreement", "label": "Client Agreement", "type": "Photo", "required": false },
        { "id": "env_questionnaire", "label": "User Environmental Questionnaire", "type": "Photo", "required": false }
      ]
