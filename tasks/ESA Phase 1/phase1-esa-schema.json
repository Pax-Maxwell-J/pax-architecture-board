        { "id": "date_ep_declaration", "label": "EP Declaration Date", "type": "Date", "required": true, "validation": ["equals:report_date"] },
        { "id": "viability_expiration", "label": "180-Day Expiration", "type": "Date", "required": true, "validation": ["computed:min(date_database_records,date_interviews,date_visual_inspection,date_ep_declaration)+180d"] }
